<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/vk"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/vk_round"
        android:theme="@android:style/Theme.DeviceDefault"> <!--Changed to In-Built Android Default Style Theme-->
        
        <activity
            android:name="android.app.NativeActivity"  
            android:configChanges="orientation|screenSize|keyboardHidden" 
            android:exported="true"> <!--NativeActivity is in-built activity, Android 12 pasoon exported=true is mandatory-->

            <meta-data 
                android:name="android.app.lib_name"
                android:value="NDKNativeAppGlue"
            /> <!--lib_name is in-built cpp madhun tayaar honaarya librarchya name ithe dya and its value=NDKNativeAppGlue i.e. library name user provided name-->
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>